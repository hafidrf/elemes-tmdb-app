# -----------------------------------------------------------------------------
# Copy this file to `.env` before running the app:
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# Then fill in your own TMDB credentials and run `npm start` + `npm run android`.
# The real `.env` file must NEVER be committed (it is git-ignored).
# -----------------------------------------------------------------------------

# Recommended: TMDB v4 "API Read Access Token".
# Get it at https://www.themoviedb.org/settings/api -> "API Read Access Token".
# Sent as `Authorization: Bearer <token>`.
TMDB_READ_ACCESS_TOKEN=

# Optional fallback: TMDB v3 API key, used only when the bearer token is empty.
# Get it at https://www.themoviedb.org/settings/api -> "API Key (v3 auth)".
TMDB_API_KEY=
