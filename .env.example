# Copy this to .env and fill in your own TMDB credentials.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# .env is git-ignored, so the key never ends up in the repo.

# v4 "API Read Access Token", the long one starting with eyJ.
# https://www.themoviedb.org/settings/api
# Sent as: Authorization: Bearer <token>
TMDB_READ_ACCESS_TOKEN=

# v3 API key. Only used when the token above is empty.
TMDB_API_KEY=
