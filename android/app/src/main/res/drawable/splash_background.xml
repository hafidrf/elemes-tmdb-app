<?xml version="1.0" encoding="utf-8"?>
<!--
  Native splash background: solid canvas colour with the logo centred.
  Applied by `SplashTheme`, which MainActivity swaps for `AppTheme` in
  onCreate(), so the splash disappears the moment React takes over.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:drawable="@drawable/splash_logo"
        android:gravity="center" />
</layer-list>
